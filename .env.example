# Copy this file to .env.local for local development.
# Never commit .env.local or any file containing a real key.

# Required for the `ask` command / AI assistant. Without this set, the site
# still works fully — the terminal and overview both function normally, and
# `ask` clearly reports that AI is disconnected instead of failing silently.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-opus-5 if unset.
ANTHROPIC_MODEL=claude-opus-5
